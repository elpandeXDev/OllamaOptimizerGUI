# ─── OllamaOptimizerGUI — Environment Configuration ───────────────────────────
# Copy this file to .env and edit values for your server deployment.

# ─── Domain ──────────────────────────────────────────────────────────────────
# Your domain name for the web interface. Caddy will auto-provision SSL.
# Use "localhost" for local testing (self-signed cert).
OOG_DOMAIN=localhost

# ─── Security ────────────────────────────────────────────────────────────────
# API key for protecting the API (optional). If set, all /api/* requests
# must include "Authorization: Bearer <key>" or "?api_key=<key>"
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OOG_API_KEY=

# CORS origins (comma-separated). Set to your domain in production.
# Example: https://oog.example.com
OOG_CORS_ORIGINS=*

# Rate limit: max requests per minute per IP (0 = disabled)
OOG_RATE_LIMIT=0

# ─── Performance ─────────────────────────────────────────────────────────────
# Number of Gunicorn workers (recommended: 2-4 per CPU core)
OOG_WORKERS=4

# Log level: debug, info, warning, error
OOG_LOG_LEVEL=info
